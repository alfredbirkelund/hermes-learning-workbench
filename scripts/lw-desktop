#!/usr/bin/env bash
# Launch a SEPARATE packaged Hermes Desktop for Learning Workbench tests.
#  - own HERMES_HOME as its own data root (HERMES_DATA_DIR_SUFFIX; see testenv.sh) and own Electron userData
#    dir (own single-instance lock)
#  - own gateway-lock dir, so its backend never attaches to the user's host gateway
#  - installed interpreter used read-only (HERMES_DISABLE_LAZY_INSTALLS=1), no environment builds
#  - basic password store, so nothing is written to the user's OS keyring
#  - DevTools protocol on a free port (recorded in $LW_TEST_ROOT/desktop-cdp-port)
# Refuses to start unless scripts/lw-isolation-check prints ISOLATED.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$here/lw-isolation-check" >/dev/null || { echo "[lw-desktop] refusing: isolation check failed" >&2; exit 1; }
# shellcheck source=testenv.sh
source "$here/testenv.sh"

runtime="${LW_HERMES_RUNTIME:-$HOME/.hermes/hermes-agent}"
app="${LW_DESKTOP_APP:-/opt/hermes-desktop/Hermes}"
port="${LW_CDP_PORT:-$(/usr/bin/python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')}"
echo "$port" > "$LW_TEST_ROOT/desktop-cdp-port"
mkdir -p "$LW_TEST_ROOT/desktop-cwd"

export HERMES_DESKTOP_USER_DATA_DIR="$LW_DESKTOP_USER_DATA"
export HERMES_DESKTOP_HERMES_ROOT="$runtime"
export HERMES_DESKTOP_PYTHON="$LW_PYTHON"
export HERMES_DESKTOP_CWD="$LW_TEST_ROOT/desktop-cwd"
export HERMES_DESKTOP_PASSWORD_STORE=basic
unset ELECTRON_RUN_AS_NODE PYTHONPATH PYTHONHOME

echo "[lw-desktop] HERMES_HOME=$HERMES_HOME (suffix $HERMES_DATA_DIR_SUFFIX)"
echo "[lw-desktop] userData=$HERMES_DESKTOP_USER_DATA_DIR"
echo "[lw-desktop] gateway locks=$HERMES_GATEWAY_LOCK_DIR"
echo "[lw-desktop] CDP port=$port"
exec "$app" --disable-setuid-sandbox --ozone-platform=wayland --password-store=basic \
  --remote-debugging-port="$port" --remote-allow-origins='*' "$@"
