#!/usr/bin/env bash
# Prove the isolated environment resolves only to the test area before anything runs in it.
# Read-only: imports Hermes modules and prints resolved paths. Exits non-zero (NOT ISOLATED) on any path that
# leaves $LW_TEST_ROOT, including the real ~/.hermes.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
runtime="${LW_HERMES_RUNTIME:-$HOME/.hermes/hermes-agent}"
# Resolve the installed interpreter BEFORE entering the isolated environment (read-only use of the runtime).
if [[ -n "${LW_PYTHON:-}" && -x "${LW_PYTHON}" ]]; then
  venv_python="$LW_PYTHON"
else
  rc="$(env -u HERMES_HOME -u HERMES_DATA_DIR_SUFFIX "$runtime/.hermes/bin/hermes" --print-runtime-command)"
  store_python="$(/usr/bin/python3 -c 'import json,sys; print(json.loads(sys.argv[1])[0])' "$rc")"
  venv_python="$(env -u HERMES_HOME -u HERMES_DATA_DIR_SUFFIX "$store_python" -I -c '
import sys; from pathlib import Path
r = Path(sys.argv[1]); sys.path.insert(0, str(r))
from pm.environments import committed_venv
e = committed_venv(r); print(e / "bin/python" if e else "")' "$runtime")"
fi
[[ -x "$venv_python" ]] || { echo "no committed Hermes venv python found" >&2; exit 2; }
# shellcheck source=testenv.sh
source "$here/testenv.sh"
if [[ "${1:-}" == "--negative-control" ]]; then
  # Same check without the suffix: it must report NOT ISOLATED, proving the check can see the leak.
  unset HERMES_DATA_DIR_SUFFIX
fi
exec "$venv_python" - "$runtime" <<'PY'
import os, sys
from pathlib import Path
sys.modules["hermes_bootstrap"] = None  # a read-only check must never re-exec itself
sys.path.insert(0, sys.argv[1])
from hermes_constants import get_default_hermes_root, get_hermes_home
from hermes_cli import profiles
from hermes_cli.process_identity import _ledger_path
from gateway.status import _get_lock_dir

root = Path(os.environ["LW_TEST_ROOT"]).resolve()
real = (Path.home() / ".hermes").resolve()
home = Path(os.environ["HERMES_HOME"]).resolve()


def inside(p: Path) -> bool:
    p = p.resolve()
    return p == root or str(p).startswith(str(root) + os.sep)


checks = {
    "HERMES_HOME": get_hermes_home(),
    "default root": get_default_hermes_root(),
    "default profile dir": profiles.get_profile_dir("default"),
    "machine spawn ledger": _ledger_path(),
    "gateway lock dir": _get_lock_dir(),
}
ok = True
for name, path in checks.items():
    good = inside(Path(path))
    ok &= good
    print(f"{'ok ' if good else 'BAD'} {name}: {Path(path).resolve()}")
for name, path in profiles.profiles_to_serve(True, include_standalone=True, include_parked=True):
    good = inside(Path(path))
    ok &= good
    print(f"{'ok ' if good else 'BAD'} served profile {name!r}: {Path(path).resolve()}")
print(f"(real Hermes root, must not appear above: {real})")
print("ISOLATED" if ok else "NOT ISOLATED")
sys.exit(0 if ok else 1)
PY
